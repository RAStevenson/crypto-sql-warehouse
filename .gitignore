.env
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Tableau artifacts. The extract is a build output of the \copy command in the
# README, and the .hyper is whatever Tableau writes beside it. Both rebuild
# from the database, so neither belongs in history. These are narrow patterns
# rather than *.csv, so committing a small test fixture stays possible.
*.hyper
tableau_extract.csv

# scheduled-run output. Rebuildable noise; raw.ingest_runs is the audit trail.
logs/

# assistant tooling - local only, never published
CLAUDE.md
.claude/

# CSV files written by scripts/run_export.py
exports/

# dbt's build artifacts and logs. target/ holds compiled SQL and the docs
# site, both rebuilt by every run; logs/dbt/ is covered by logs/ above.
dbt/target/
dbt/dbt_packages/
dbt/package-lock.yml
